flowchart LR
  subgraph URL["URL / router state"]
    A1["Active chat thread id"]
    A2["Active assistant thread id"]
    A3["Active subject slug"]
  end
  subgraph RCS["React component state"]
    B1["Google Calendar events (fetched)"]
    B2["responseLanguageHint (in-memory ref)"]
    B3["Auth form fields"]
  end
  subgraph CTX["Context / provider state"]
    C1["Planner events + assessments<br/>(AppDataProvider)"]
    C2["Academic year selection<br/>(AcademicYearProvider)"]
    C3["Theme<br/>(ThemeProvider)"]
    C4["App language (live value)<br/>(I18nProvider)"]
  end
  subgraph LS["localStorage"]
    D1["asa.data.v2 (planner/assessments/materials/links/profile)"]
    D2["asa.year.v1 (academic year)"]
    D3["alim.app_language (language cache)"]
    D4["theme cache"]
  end
  subgraph SS["sessionStorage"]
    E1["Google provider OAuth token"]
    E4["alim.language_session.v1<br/>(per-session language DECISION: selected | skipped)"]
    E5["alim.ai_session.v1<br/>(per-session AI DECISION: ai-ready | non-ai; model/GPU readiness<br/>is NEVER stored in Supabase)"]
  end
  subgraph AUTH["Supabase Auth session"]
    F1["Active user"]
  end
  subgraph PG["Supabase PostgreSQL"]
    G1["profiles.username"]
    G2["user_preferences.preferences<br/>DURABLE PREFERENCES ONLY: app_language (SAVED DEFAULT HINT (never counts as the session selection)),<br/>selected_qwen_model (preferred, not readiness),<br/>language_onboarding_completed (LEGACY metadata)"]
    G3["threads / messages"]
    G4["assistant_threads / assistant_messages / assistant_attachments"]
    G5["feedback"]
    G6["usage_events"]
    G7["media_retention_queue"]
    G8["documents / document_chunks"]
  end
  subgraph ST["Supabase Storage"]
    H1["profile-avatars"]
    H2["chat-attachments"]
    H3["feedback-messages"]
    H4["activity-logs"]
    H5["assistant-descriptors"]
    H6["user-materials"]
  end
  subgraph EXT["Provider / OAuth tokens"]
    I1["GitHub / LinkedIn / Spotify sign-in (Supabase-managed)"]
  end
  subgraph BE["Local backend / model-context state"]
    J1["Retrieval + model context per chat turn"]
    J2["Local Qwen runtime (port 8000)"]
  end

  C1 --> D1
  C2 --> D2
  C4 --> D3
  C3 --> D4
  C4 --> G2
  G4 --> H2
  G1 --> H1


  subgraph SS2["sessionStorage (this pass)"]
    E2["alim.admission_session.v1 (admission lease)"]
    E3["alim.messaging_session.v1 (transient composer/attachment state)"]
  end
  subgraph CTX2["Context / provider state (this pass)"]
    C5["SafetyAvailabilityProvider (safety backend up/down)"]
  end
  subgraph PG2["Supabase PostgreSQL (this pass)"]
    G9["account_compliance"]
    G10["user_legal_consents"]
    G11["moderation_events"]
    G12["guardian_notification_queue"]
    G13["peer_conversations / peer_conversation_members / peer_messages / peer_message_attachments / peer_message_notifications"]
  end
  subgraph ST2["Supabase Storage (this pass)"]
    H7["peer-message-attachments (private)"]
  end
  subgraph BE2["Local backend / admission-safety state (EXPECTED LOCAL BACKEND CONTRACT)"]
    J3["Admission session lease reconciliation"]
    J4["Safety moderation verdicts"]
  end

  E2 -.->|"reconciled against"| J3
  E4 -.->|"cleared on sign-out"| F1
  E5 -.->|"cleared on sign-out"| F1
  G2 -.->|"saved defaults/hints only: never a completed session decision, never readiness"| E5
  C5 -.->|"polls"| J4
  G13 --> H7

%% CURRENT (2026-09-17): the authenticated startup flow is auth → PER-SESSION
%% language decision (select or explicit skip) → PER-SESSION model decision
%% (backend-confirmed ready, or explicit continue-without-AI) → product. Language
%% onboarding is NOT once-per-account; language_onboarding_completed is legacy
%% metadata only. There is NO mandatory system-admission screen between them, and
%% /onboarding/model redirects to /onboarding/language while that decision is
%% missing. Canonical: docs/sequences/POST_LOGIN_STARTUP.mmd. Model/GPU readiness
%% lives in sessionStorage only, never in Supabase. auto_storage_cleanup user
%% preference removed; cleanup is a platform-wide cron (STORAGE_CAPACITY_CLEANUP.mmd).

