%% Planned quiz / mock exam / grading tools. Not implemented in the current backend.
flowchart TD
  AiGate{"AI decision this session?<br/>useAiBlocked() / AiFeatureGate"} -->|"non-AI or unavailable"| Blocked["Localized red notice: no request is issued.<br/>Paths: retry model setup, Settings, keep non-AI features"]
  AiGate -->|"backend-confirmed ready"| Subject
  Subject["Subject workspace tools tab"] --> Quiz["Generate quiz<br/>FUTURE CODEX IMPLEMENTATION"]
  Subject --> Exam["Generate mock exam<br/>FUTURE CODEX IMPLEMENTATION"]
  Subject --> Grade["Grade answer<br/>FUTURE CODEX IMPLEMENTATION"]
  Quiz -.-> QAPI["POST /api/quiz/generate"]
  Exam -.-> EAPI["POST /api/mock-exam/generate"]
  Grade -.-> GAPI["POST /api/grade"]
  QAPI -.-> Retrieve["Backend retrieves goals and materials"]
  EAPI -.-> Retrieve
  GAPI -.-> Rubric["Backend retrieves rubric and references"]
  Retrieve -.-> Model["Local model runtime (llama.cpp / Qwen)"]
  Rubric -.-> Model
  Model -.-> QuizUI["Quiz questions + sources"]
  Model -.-> ExamUI["Exam questions + points + rubrics"]
  Model -.-> Result["Points + strengths + gaps + advice + sources"]
  QuizUI -.-> Answers["Student answers and sees score"]
  ExamUI -.-> Grade
  Result -.-> Formula["Exact grade = 1 + 5 * points/max, clamped 1 to 6"]
  Formula -.-> Display["Frontend rounds to 0.5 and marks below 4.0"]
  Display -.-> Confirm{"Save as practice assessment?"}
  Confirm -. yes .-> Local["Browser storage via AppDataProvider<br/>CURRENT - FRONTEND once a result exists"]
