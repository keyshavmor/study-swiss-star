  Text["POST /api/context/documents/text<br/>CURRENT - BACKEND"] --> Chunk
  Transcript["TranscriptImportDialog: simulated OCR, review, confirm"] --> Assessments["Local assessments only<br/>CURRENT - FRONTEND"]
