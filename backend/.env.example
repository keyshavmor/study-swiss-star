# Canonical user persistence. The normal path uses a publishable key plus the
# verified request JWT, never a service-role key.
SUPABASE_URL=https://ucacmeadsufiedxrgqit.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=ucacmeadsufiedxrgqit

# FastAPI binds to loopback and accepts only the local frontend origins/hosts by
# default. Remote/LAN operation requires deliberate hardening and explicit
# ALIM_ALLOW_* opt-in; Lovable is never a runtime origin.
ALIM_BACKEND_HOST=127.0.0.1
ALIM_BACKEND_PORT=8001
ALIM_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
ALIM_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
ALIM_ALLOW_NON_LOOPBACK=false
ALIM_ALLOW_REMOTE_FRONTEND_ORIGINS=false

# SQLite is only used by explicitly constructed test adapters.
ALIM_CONTEXT_DB=:memory:
ALIM_CONTEXT_DEBUG=false
# Model data defaults to the OS data directory, outside Git.
# ALIM_MODEL_CACHE_ROOT=/absolute/path/to/alim-models
# ALIM_MODEL_PATH=/absolute/path/to/alim-models/Qwen--Qwen3.8-27B
ALIM_MODEL_AUTOSTART=false
ALIM_MODEL_AUTO_DOWNLOAD=false
ALIM_MODEL_HOST=127.0.0.1
ALIM_MODEL_PORT=8000
ALIM_MODEL_SERVER_EXECUTABLE=llama-server
ALIM_MODEL_STARTUP_TIMEOUT_SECONDS=1800
# Optional platform-aware llama.cpp overrides; defaults are documented and tested.
# ALIM_MODEL_THREADS=16
# ALIM_MODEL_BATCH_SIZE=512
# ALIM_MODEL_GPU_LAYERS=-1
# ALIM_RUNTIME_STATE_ROOT=/absolute/path/to/alim-runtime-state
ALIM_LLM_BASE_URL=http://127.0.0.1:8000/v1
ALIM_LLM_MODEL=Qwen/Qwen3.8-27B
ALIM_LLM_API_KEY=local
ALIM_EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
# Leave unset for the deterministic offline hashing fallback.
# ALIM_EMBEDDING_MODEL=nomic-embed-text
ALIM_EMBEDDING_API_KEY=local
ALIM_EMBEDDING_TIMEOUT_SECONDS=30
# Optional overrides. Defaults adapt to CUDA VRAM or Apple unified memory.
# ALIM_MAX_CONTEXT_TOKENS=32768
# ALIM_RESERVED_OUTPUT_TOKENS=8192
ALIM_WEB_ENABLED=true
ALIM_WEB_PROVIDER=auto
ALIM_LOCAL_WEB_ROOT=material/web
ALIM_WEB_TOKENS=6000
ALIM_WEB_MAX_RESULTS=4
ALIM_WEB_TIMEOUT_SECONDS=8
ALIM_WEB_CACHE_TTL_MINUTES=1440
ALIM_RERANK_LIMIT=6
ALIM_RECENT_MESSAGE_COUNT=8
ALIM_SUMMARY_MESSAGE_THRESHOLD=20
ALIM_SUMMARY_TOKEN_THRESHOLD=8000
ALIM_MEMORY_MIN_CONFIDENCE=0.65
