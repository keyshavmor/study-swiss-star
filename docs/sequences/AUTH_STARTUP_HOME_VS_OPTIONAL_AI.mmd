%% Status: CURRENT FRONTEND + CURRENT SUPABASE (2026-09-17)
%% RULE: the local AI runtime is NEVER an authentication gate — but the model
%% screen IS a mandatory per-session DECISION gate (ready, or explicit non-AI).
%% Canonical detail: docs/sequences/POST_LOGIN_STARTUP.mmd
%% Source: frontend/src/lib/startup-flow.ts, lib/language-session.ts,
%% lib/ai-session.ts, components/app/AiFeatureGate.tsx
sequenceDiagram
    participant User
    participant Supa as Supabase Auth
    participant Flow as lib/startup-flow.ts
    participant Lang as /onboarding/language (session decision)
    participant Model as /onboarding/model (session decision)
    participant Backend as REQUIRED FUTURE BACKEND
    participant Home as /home + non-AI areas
    participant AiFeat as AI features (chat, assessments, grading)

    User->>Supa: sign in
    Supa-->>Flow: session — authentication complete, AI irrelevant here
    Flow-->>Lang: language decision required this session
    Lang-->>Model: selected or skipped
    Model->>Backend: probe + prepare
    alt backend confirms ready
        Backend-->>Model: ready
        Model-->>Home: AI-ready session
        Home->>AiFeat: AI actions enabled
    else backend unavailable / blocked / failed
        Backend-->>Model: no ready confirmation
        User->>Model: explicit "Continue without AI" (or retry / sign out)
        Model-->>Home: non-AI session — full product access
        Home->>AiFeat: every AI action disabled with one red notice<br/>+ retry model setup / Settings link
    end
