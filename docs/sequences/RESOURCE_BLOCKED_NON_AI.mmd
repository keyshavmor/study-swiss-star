%% NOTE 2026-09-17: the canonical post-login sequence is now
%% docs/sequences/POST_LOGIN_STARTUP.mmd — auth → per-session language decision
%% → mandatory model decision (backend-confirmed ready OR explicit non-AI) → app.
%% There is no separate mandatory system-admission screen.
%% Status: CURRENT FRONTEND (UI reaction) / EXPECTED LOCAL BACKEND CONTRACT (resource evaluation)
%% Source: frontend/src/routes/_authenticated/onboarding.model.tsx,
%% frontend/src/components/app/ModelReadinessPanel.tsx, frontend/src/lib/ai-session.ts
sequenceDiagram
    participant Backend as EXPECTED LOCAL BACKEND CONTRACT
    participant Panel as ModelReadinessPanel.tsx
    participant Page as onboarding.model.tsx (or Settings)
    participant Session as ai-session.ts (sessionStorage)
    participant User

    Backend-->>Panel: state=blocked,<br/>blocking_reasons=[insufficient_gpu_vram | insufficient_ram | insufficient_storage],<br/>can_continue_with_ai=false, can_continue_without_ai=true
    Panel->>Panel: toneForStatus() → "danger" (or "degraded" if can_continue_with_ai)
    Panel-->>User: red/amber card, resource cards below floor shown in destructive color,<br/>"model.warning.resourcePressure" hint
    Page->>Page: onUnavailable(status) → ai.setUnavailable()
    User->>Page: click "Continue without AI"
    Page->>Session: markNonAi()
    Session-->>Page: { mode: "non-ai", modelId: null }
    Page-->>User: navigate to /home
    Note over User: Home renders normally; AI-dependent features show AiUnavailableNotice<br/>instead of crashing or fabricating a response.
