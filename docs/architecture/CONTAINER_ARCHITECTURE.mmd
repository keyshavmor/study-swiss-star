    RAG["Retrieval / RAG<br/>BACKEND IMPLEMENTATION UNKNOWN"]
    DOCPROC["Document processing<br/>BACKEND IMPLEMENTATION UNKNOWN"]
    MEMORY["Student memory<br/>BACKEND IMPLEMENTATION UNKNOWN"]
    ORCH["AI orchestration<br/>BACKEND IMPLEMENTATION UNKNOWN"]
    MODELIF["Local model interface<br/>BACKEND IMPLEMENTATION UNKNOWN"]
    MEDIAPROC["Media processing<br/>BACKEND IMPLEMENTATION UNKNOWN"]
    WEBRET["Web retrieval<br/>BACKEND IMPLEMENTATION UNKNOWN"]
    MODEL["Local model runtime :8000<br/>llama.cpp / Qwen"]
  end

  ROUTER --> AUTHUI & HOME & SCHOOL & PLANNER & ASSISTANT & STATS & HELP & FEEDBACK & PROFILE
  HOME --> I18N
  ASSISTANT --> SPEECH
  ROUTER --> SUPACLIENT
  PLANNER --> GCAL
  ASSISTANT --> APICHAT

  SUPACLIENT --> SAUTH
  SUPACLIENT --> SPG
  SUPACLIENT --> SSTORAGE
  SUPACLIENT --> SEDGE
  SPG --> SRLS
  SSTORAGE --> SRLS
  SEDGE --> SRETENTION

  APICHAT --> SAUTH
  APICHAT --> SPG
  APICHAT -->|"POST /api/chat, X-Student-Id header"| CHATEP
  CHATEP --> CTXMGR
  CTXMGR --> RAG
  CTXMGR --> DOCPROC
  CTXMGR --> MEMORY
  CTXMGR --> ORCH
  ORCH --> MODELIF
  MODELIF --> MODEL
  CTXMGR --> MEDIAPROC
  CTXMGR --> WEBRET


  subgraph BROWSER2["Browser (compliance/messaging/system-health screens, this pass)"]
    COMPLIANCEUI["ComplianceOnboarding, SystemAdmissionGate"]
    LEGALUI["LegalDocumentPage"]
    MESSAGINGUI["messaging/* components"]
    SYSHEALTHUI["SystemHealthPanel"]
    DATARIGHTSUI["DataRightsPanel"]
  end

  subgraph LOCALMACHINE2["Trust boundary: Student local machine (admission/safety/messaging, this pass)"]
    ADMISSIONEP["/api/system/admission/check, /api/system/health,<br/>/api/system/session/heartbeat, /api/system/runtime/release,<br/>/api/system/model/recommendation<br/>EXPECTED BACKEND CONTRACT"]
    SAFETYEP["/api/safety/moderate, /api/safety/attachment-scan<br/>EXPECTED BACKEND CONTRACT"]
    PEERSENDEP["/api/peer-messaging/send<br/>EXPECTED BACKEND CONTRACT"]
  end

  ROUTER --> COMPLIANCEUI & LEGALUI & MESSAGINGUI & SYSHEALTHUI & DATARIGHTSUI
  COMPLIANCEUI -->|"fail-closed admission"| ADMISSIONEP
  SYSHEALTHUI -->|"unavailable when missing"| ADMISSIONEP
  ASSISTANT -->|"moderate before store/answer"| SAFETYEP
  MESSAGINGUI -->|"fail-closed send"| SAFETYEP
  MESSAGINGUI -->|"fail-closed send"| PEERSENDEP
  COMPLIANCEUI --> SUPACLIENT
  MESSAGINGUI --> SUPACLIENT
  DATARIGHTSUI --> SUPACLIENT
  DATARIGHTSUI -->|"delete-my-data"| SEDGE

