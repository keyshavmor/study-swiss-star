%% Component composition tree for the authenticated shell and StudyChat.
flowchart TD
  HTML["RootShell (__root.tsx): HTML + head + scripts"] --> Root[RootComponent]
  Root --> Query[QueryClientProvider]
  Query --> I18nP["I18nProvider<br/>frontend/src/lib/i18n/{languages,detect,format,provider}.ts"]
  I18nP --> Theme[ThemeProvider]
  Theme --> Data[AppDataProvider]
  Data --> Year[AcademicYearProvider]
  Year --> Outlet[Router Outlet]
  Year --> Toast[Global Toaster]
  Outlet --> Public["Public screens: index.tsx, auth.tsx, auth.update-password.tsx<br/>localised"]
  Outlet --> Gate["_authenticated/route.tsx gate"]
  Gate --> Pages["home, school.index, school.$subject, planner, stats,<br/>assistant.index, assistant.$threadId,<br/>profile, settings, feedback, help"]
  Pages --> Shell[AppShell.tsx]
  Shell --> Header["AppHeader.tsx<br/>LiveClock, ThemeToggle, NotificationCenter,<br/>LanguageMenu, profile avatar dropdown<br/>logo links to /home"]
  Header --> LangMenu["LanguageMenu.tsx<br/>components/app/LanguageMenu.tsx"]
  Shell --> Content[Route content]
  Shell --> Footer["AppFooter (AppShell.tsx): Feedback + Help links"]
  Shell --> Mobile["MobileNavigation.tsx<br/>Home / School / Planner / Assistant tabs"]
  Gate --> Chat["StudyChat.tsx full-height shell (chat.index / chat.$threadId)"]
  Chat --> Threads[ThreadList]
  Chat --> Conversation["AI Elements Conversation + Message"]
  Chat --> Speech["Listen / Stop read-aloud button<br/>lib/speech.ts, completed assistant messages only"]
  Chat --> Composer["AI Elements PromptInput + Shimmer"]
  Conversation --> Sources[SourceSnippetList]
  Pages --> UI[shadcn and Radix primitives]
